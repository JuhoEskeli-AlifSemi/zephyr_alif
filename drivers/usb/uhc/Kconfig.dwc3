config UHC_DWC3
	bool "Synopsys DWC3 USB Host Controller driver"
	default y
	depends on DT_HAS_SNPS_DWC3_HOST_ENABLED
	help
	  Enable the Synopsys DesignWare DWC3 USB Host Controller driver.
	  This driver operates the DWC3 IP in host mode, supporting
	  USB 2.0 High Speed and Full Speed devices.

if UHC_DWC3

config UHC_DWC3_THREAD_STACK_SIZE
	int "Driver internal thread stack size"
	default 2048
	help
	  Size of the stack used for the DWC3 UHC transfer processing thread.

config UVC_HOST
	bool "USB Video Class host helpers for the DWC3 host controller"
	help
	  UVC configuration descriptor parsing, Probe/Commit format
	  negotiation and frame reassembly from bulk or isochronous payloads,
	  on top of the DWC3 host controller helpers (uhc_dwc3.h).

if UVC_HOST

module = UVC_HOST
module-str = UVC host helpers
source "subsys/logging/Kconfig.template.log_config"

endif # UVC_HOST

endif # UHC_DWC3
